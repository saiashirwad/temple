{
  "name": "temple",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tools",
    "test": "tsx --test tests/*.test.ts",
    "lint": "node tools/lint-leftovers.mjs",
    "check": "npm run -s lint && npm run -s test && npm run -s assets && npm run -s typecheck && echo CHECK OK",
    "assets": "tsx tools/check/assets.ts",
    "gen:trail": "tsx tools/trail/make.ts && tsx tools/river/make.ts && tsx tools/trail/map.ts",
    "gen:tex": "tsx tools/tex/bake.ts && tsx tools/tex/photo.ts && tsx tools/posters/make.ts && tsx tools/posters/signs.ts",
    "gen:models": "tsx tools/models/fetch.ts",
    "gen:beasts": "nice npx tsx tools/beasts/elephant.ts && nice npx tsx tools/beasts/dhole.ts",
    "gen:people": "tsx tools/people/build.ts && tsx tools/people/shrink.ts",
    "scenario": "tsx tools/scenario.ts"
  },
  "dependencies": {
    "@typegpu/color": "0.12.2",
    "@typegpu/kit": "^0.1.0",
    "@typegpu/noise": "0.12.1",
    "box3d.js": "^0.1.1",
    "typegpu": "0.12.11"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@napi-rs/canvas": "^1.2.0",
    "@types/node": "^22.20.7",
    "@webgpu/types": "^0.1.74",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "npm:tsover@6.0.2",
    "unplugin-typegpu": "0.12.8",
    "vite": "8.3.8"
  }
}
